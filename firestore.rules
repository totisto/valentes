rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Funções Auxiliares de Autenticação e Permissão
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Administrador Principal Exclusivo: lucasj6k@gmail.com
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lucasj6k@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'lucasj6k@gmail.com' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Professor autenticado com perfil ativo no sistema
    function isTeacher() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordenador'
        )
      );
    }

    // Professor ou Administrador
    function isTeacherOrAdmin() {
      return isAdmin() || isTeacher();
    }

    // Regra padrão de bloqueio
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. PONTUAÇÕES (scoreEntries)
    // - Leitura: Disponível a usuários autenticados para cálculo dos rankings oficiais.
    // - Escrita: EXCLUSIVA para Professores e Administradores (alunos não alteram pontos).
    // - Exclusão: Professores e Administrador.
    // ===============================================================
    match /scoreEntries/{entryId} {
      allow read: if isSignedIn();

      allow create: if isTeacherOrAdmin() &&
        isValidId(entryId) &&
        request.resource.data.points is number &&
        request.resource.data.studentId is string &&
        request.resource.data.teacherId is string;

      allow update: if isTeacherOrAdmin() &&
        isValidId(entryId) &&
        request.resource.data.points is number;

      allow delete: if isTeacherOrAdmin() &&
        isValidId(entryId);
    }

    // ===============================================================
    // 2. USUÁRIOS (users)
    // - Usuários não autenticados NÃO podem ler perfis.
    // - Alunos autenticados podem ler SOMENTE seus próprios dados (request.auth.uid == userId).
    // - Professores e Administrador podem consultar os perfis para gestão e listagem.
    // - Atualização por alunos restrita à whitelist: ['name', 'avatarSeed', 'lastLogin', 'updatedAt'].
    // - Vínculo de studentId e alteração de role: EXCLUSIVO do Administrador.
    // ===============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacherOrAdmin());

      // Criação de perfil:
      // - Aluno cria apenas o próprio perfil com role 'student' e SEM studentId (vínculo pendente), nem senhas.
      // - Administrador pode criar qualquer perfil (incluindo novos professores com UID real).
      allow create: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'student' &&
          !request.resource.data.keys().hasAny(['initialPassword', 'password', 'studentId'])
        ) ||
        isAdmin()
      );

      // Atualização de perfil:
      // - Aluno pode atualizar SOMENTE campos cosméticos/pessoais (whitelist explícita).
      // - NUNCA pode alterar 'studentId', 'role', 'email', 'active' ou senhas.
      // - Somente o Administrador Principal pode alterar roles, studentId e permissões.
      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarSeed', 'lastLogin', 'updatedAt'])
        ) ||
        isAdmin()
      );

      // Exclusão de contas: EXCLUSIVO do Administrador
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. ALUNOS (students)
    // - Leitura disponível a usuários autenticados para exibição nos rankings.
    // - Criação: Professores e Administrador.
    // - Atualização de dados cadastrais: Professores e Admin.
    // - Vínculo do campo 'authUid': EXCLUSIVO do Administrador Principal (lucasj6k@gmail.com).
    // - Exclusão de alunos: EXCLUSIVO do Administrador.
    // ===============================================================
    match /students/{studentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isTeacherOrAdmin();

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isTeacher() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid'])
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. CATEGORIAS DE AVALIAÇÃO (categories)
    // - Leitura para formulários e relatórios para usuários autenticados.
    // - Criação e edição: Professores e Administrador.
    // - Exclusão de categorias: EXCLUSIVO do Administrador.
    // ===============================================================
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin() && isValidId(categoryId);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // ===============================================================
    // 5. CONFIGURAÇÕES DO SISTEMA (settings)
    // - Leitura para usuários autenticados.
    // - Alteração e controle: EXCLUSIVO do Administrador (lucasj6k@gmail.com).
    // ===============================================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
